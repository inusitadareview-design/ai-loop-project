# AI Loop Project — Environment Variables
# Copy this file to .env and fill in your credentials:
#   cp .env.example .env

# ============================================================================
# OMNI ROUTE (Primary AI Provider)
# ============================================================================
# API key for OmniRoute (REQUIRED for primary model routing)
# Get your key at: https://omniroute.ai/dashboard
OMNI_ROUTE_API_KEY=your_omniroute_api_key_here

# OmniRoute endpoint (optional — discovery.go resolves automatically)
# Leave empty to use default: api.omniroute.ai
# OMNI_ROUTE_URL=https://api.omniroute.ai

# ============================================================================
# OPENROUTER (Fallback Provider)
# ============================================================================
# API key for OpenRouter (used when OmniRoute fails or for free-tier models)
# Get your key at: https://openrouter.ai/keys
# Leave empty if you don't want to use OpenRouter fallbacks
OPENROUTER_API_KEY=

# ============================================================================
# PIPELINE SECRETS (G2.1 — Never commit these)
# ============================================================================
# Webhook URL for publishing approved drafts (G3.2)
# Used by pipelines with endpoint_env: AILOOP_BLOG_WEBHOOK
# Example: https://your-blog.com/api/webhook/ailoop
AILOOP_BLOG_WEBHOOK=

# ============================================================================
# RUNTIME CONFIGURATION (Optional)
# ============================================================================
# Log level: debug, info, warn, error (default: info)
# AILOOP_LOG_LEVEL=info

# Data directory (default: ./data)
# AILOOP_DATA_DIR=./data

# HTTP server host (default: 127.0.0.1 — G2.4: localhost only)
# AILOOP_HTTP_HOST=127.0.0.1

# HTTP server port (default: 8080)
# AILOOP_HTTP_PORT=8080

# ============================================================================
# BUDGET & COSTS (G1.1 — Free-tier enforcement)
# ============================================================================
# Daily budget limit in USD (default: 0.0 = free tier only)
# BUDGET_DAILY_LIMIT_USD=0.0

# ============================================================================
# SCHEDULER (Optional)
# ============================================================================
# Timezone for cron schedules (default: UTC)
# SCHEDULER_TIMEZONE=America/Sao_Paulo

# Maximum concurrent pipelines (default: 1)
# SCHEDULER_MAX_CONCURRENT=1

# Lock stale timeout in seconds (default: 3600 = 1 hour)
# SCHEDULER_LOCK_STALE_SECONDS=3600
